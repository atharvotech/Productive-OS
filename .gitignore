_temp_tracker.py
_window_dump.json
_window_dump.txt
_check_time.py
_clean_stale.py
_style_dump.json
scratch_check_8080.py
scratch_search.py

# Environments & Virtual Envs
venv/
env/
.env
.venv
pip-log.txt
setup.cfg

# IDE specific 
.vscode/
.antigravity/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
desktop.ini

# Distribution / Packaging
dist/
build/
*.exe
*.msi

# Build pipeline artifacts
installer/
_build_src/
dev_setup.iss
prod_setup.iss
*.spec
